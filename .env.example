# Copy to .env and adjust. .env is gitignored. Never commit real secrets.

# --- Postgres (shared by both backends) ---
POSTGRES_USER=pf
POSTGRES_PASSWORD=pf
POSTGRES_DB=personal_finance

# Connection string. Use localhost when running a backend on the host;
# use the service name `postgres` when the backend runs inside docker-compose.
DATABASE_URL=postgresql://pf:pf@localhost:5432/personal_finance

# --- Service ports ---
PYTHON_API_PORT=8000      # backend-python (FastAPI)
TS_API_PORT=3000          # backend-ts (NestJS)

# --- Frontend ---
# Point the frontend at whichever backend you want to exercise.
VITE_API_BASE_URL=http://localhost:8000

# --- App config ---
# Path to the gitignored accounts file seeded from real balances.
ACCOUNTS_CONFIG=config/accounts.yaml

# --- Data connectors (server-side only; NEVER commit real values) ---
# Plaid (transactions / liabilities / investments / income). CI runs on
# Sandbox; Trial is local-only. env is one of: sandbox | development | production.
PLAID_CLIENT_ID=plaid-client-id-placeholder
PLAID_SECRET=plaid-secret-placeholder
PLAID_ENV=sandbox

# RentCast (property listings / comps). API-key auth.
RENTCAST_API_KEY=rentcast-api-key-placeholder

# AES-256-GCM key used to encrypt Plaid access tokens at rest in plaid_items.
# Generate a real 32-byte key locally (e.g. `openssl rand -base64 32`); keep it
# only in your gitignored .env.
APP_ENCRYPTION_KEY=generate-a-32-byte-base64-key-here

# --- MCP secrets ---
# Used by .mcp.json (copy .mcp.json.example -> .mcp.json). Keep the real key out of git.
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
